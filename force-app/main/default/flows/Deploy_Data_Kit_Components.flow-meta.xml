<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls an action to deploy a data kit component from an autolaunched flow.</description>
        <name>DeployDataKitComponent</name>
        <label>Deploy Data Kit Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>dataKitDeployComponentAction</actionName>
        <actionType>dataKitDeployComponentAction</actionType>
        <connector>
            <targetReference>WaitForDataKitComponentDeployment</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>dataKitName</name>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>dataSpaceName</name>
            <value>
                <elementReference>dataKitDataSpaceInput</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>dataKitDeployInput</name>
            <value>
                <elementReference>IterateOverDataKitComponents</elementReference>
            </value>
        </inputParameters>
        <nameSegment>dataKitDeployComponentAction</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if deployment is successful.</description>
        <name>CheckDeploymentStatus</name>
        <label>Check Deployment Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateLogRecordDataKitComponentDeploymentFailure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Deployment Failed</defaultConnectorLabel>
        <rules>
            <name>IsDeploymentSuccessful</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dataKitEventResponse.IsDataKitDeployStatusSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ACTIVE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DataKitComponentDeploymentSuccessLog</targetReference>
            </connector>
            <label>Is Deployment Successful</label>
        </rules>
    </decisions>
    <description>Deploys data kit components sequentially, iterating through each component and checking the status with a deployment event before proceeding to the next event.</description>
    <environments>Default</environments>
    <interviewLabel>Deploy Data Kit Component {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deploy Data Kit Components</label>
    <loops>
        <description>Iterates over the list of data kit components and deploys each one.</description>
        <name>IterateOverDataKitComponents</name>
        <label>Iterate Over Data Kit Components</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>dataKitComponentsInput</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>DeployDataKitComponent</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>UpdateDataKitDeploymentStatus</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates a log entry for the time that the data kit deployment begins in the flow.</description>
        <name>CreateDataKitDeploymentStartLog</name>
        <label>Create Data Kit Deployment Start Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IterateOverDataKitComponents</targetReference>
        </connector>
        <inputAssignments>
            <field>DataKitName</field>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DataSpaceName</field>
            <value>
                <elementReference>dataKitDataSpaceInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeployJob</field>
            <value>
                <elementReference>DeployDataKitComponent.jobId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeploymentStatus</field>
            <value>
                <stringValue>Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FlowInterviewIdentifier</field>
            <value>
                <elementReference>$Flow.InterviewGuid</elementReference>
            </value>
        </inputAssignments>
        <object>DataKitDeploymentLog</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Stores a record for the data kit component deployment failure.</description>
        <name>CreateLogRecordDataKitComponentDeploymentFailure</name>
        <label>Create Log Record for Component Deployment Failure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DataKitDeploymentEventError</targetReference>
        </connector>
        <inputAssignments>
            <field>ComponentName</field>
            <value>
                <elementReference>dataKitEventResponse.TemplateName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DataKitName</field>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DataSpaceName</field>
            <value>
                <elementReference>dataKitDataSpaceInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeployJob</field>
            <value>
                <elementReference>dataKitEventResponse.JobIdentifier</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeploymentError</field>
            <value>
                <elementReference>dataKitEventResponse.ErrorDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeploymentStatus</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FlowInterviewIdentifier</field>
            <value>
                <elementReference>$Flow.InterviewGuid</elementReference>
            </value>
        </inputAssignments>
        <object>DataKitDeploymentLog</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Creates a record log that the data kit component deployed.</description>
        <name>DataKitComponentDeploymentSuccessLog</name>
        <label>Data Kit Component Deployment Success Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IterateOverDataKitComponents</targetReference>
        </connector>
        <inputAssignments>
            <field>ComponentName</field>
            <value>
                <elementReference>dataKitEventResponse.TemplateName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DataKitName</field>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DataSpaceName</field>
            <value>
                <elementReference>dataKitDataSpaceInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeployJob</field>
            <value>
                <elementReference>dataKitEventResponse.JobIdentifier</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeploymentStatus</field>
            <value>
                <stringValue>Successful</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FlowInterviewIdentifier</field>
            <value>
                <elementReference>$Flow.InterviewGuid</elementReference>
            </value>
        </inputAssignments>
        <object>DataKitDeploymentLog</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Creates an event record for any data kit components that failed to deploy.</description>
        <name>DataKitDeploymentEventError</name>
        <label>Data Kit Deployment Event Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateDataKitDeployment</targetReference>
        </connector>
        <inputAssignments>
            <field>DataKitName</field>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ErrorDetails</field>
            <value>
                <elementReference>dataKitEventResponse.ErrorDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsDataKitDeployStatusSuccess</field>
            <value>
                <elementReference>dataKitEventResponse.IsDataKitDeployStatusSuccess</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>JobIdentifier</field>
            <value>
                <elementReference>dataKitEventResponse.JobIdentifier</elementReference>
            </value>
        </inputAssignments>
        <object>DataKitDeployEvent</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Creates a record for the data kit components that were deployed from the flow.</description>
        <name>DataKitDeploymentEventSucceeded</name>
        <label>Data Kit Deployment Event Succeeded</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>DataKitName</field>
            <value>
                <elementReference>dataKitNameInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsDataKitDeployStatusSuccess</field>
            <value>
                <elementReference>dataKitEventResponse.IsDataKitDeployStatusSuccess</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>JobIdentifier</field>
            <value>
                <elementReference>$Flow.InterviewGuid</elementReference>
            </value>
        </inputAssignments>
        <object>DataKitDeployEvent</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <description>Updates the data kit deployment</description>
        <name>UpdateDataKitDeployment</name>
        <label>Update Data Kit Deployment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CreateDataKitDeploymentStartLog</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DeploymentStatus</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>DataKitDeploymentLog</object>
    </recordUpdates>
    <recordUpdates>
        <description>Stores the time at which all the components in the data kit were deployed in the Start Log.</description>
        <name>UpdateDataKitDeploymentStatus</name>
        <label>Update Data Kit Deployment Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DataKitDeploymentEventSucceeded</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CreateDataKitDeploymentStartLog</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DeploymentStatus</field>
            <value>
                <stringValue>Successful</stringValue>
            </value>
        </inputAssignments>
        <object>DataKitDeploymentLog</object>
    </recordUpdates>
    <sourceTemplate>sfdatakit__DeployDataKitComponents</sourceTemplate>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateDataKitDeploymentStartLog</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <description>A list that contains the sequential order of data kit components.</description>
        <name>dataKitComponentsInput</name>
        <apexClass>sfdatakit__DeployComponentInput</apexClass>
        <dataType>Apex</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The data space name to deploy the components from.</description>
        <name>dataKitDataSpaceInput</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>DataKit event response after DataKit component deployment.</description>
        <name>dataKitEventResponse</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>DataKitDeployEvent</objectType>
    </variables>
    <variables>
        <description>The data kit name to deploy the components from.</description>
        <name>dataKitNameInput</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <waits>
        <description>Waits for the deployment of a data kit component, and exits on timeout or  failure of a deploy event.</description>
        <name>WaitForDataKitComponentDeployment</name>
        <label>Wait for Data Kit Component Deployment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>ComponentDeploymentEventReceived</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>CheckDeploymentStatus</targetReference>
            </connector>
            <eventType>DataKitDeployEvent</eventType>
            <inputParameters>
                <name>JobIdentifier</name>
                <value>
                    <elementReference>DeployDataKitComponent.jobId</elementReference>
                </value>
            </inputParameters>
            <label>Component Deployment Event Received</label>
            <outputParameters>
                <assignToReference>dataKitEventResponse</assignToReference>
                <name>DataKitDeployEvent</name>
            </outputParameters>
        </waitEvents>
    </waits>
</Flow>
