<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Closure_Notification</name>
        <label>Send Closure Notification to Case Owner</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Owner:User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Outgoing Exchange Case Closed: {!$Record.CaseNumber}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>The Outgoing Exchange case for {!$Record.Contact.Name} has been closed.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>ISB-6099 — Record-triggered flow on Case. When Status changes to Closed on an Outgoing Exchange Case, sends a closure notification email to the Case Owner.</description>
    <label>Outgoing Case Closure Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Send_Closure_Notification</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Status}, &apos;Closed&apos;) &amp;&amp; ISCHANGED({!$Record.Status}) &amp;&amp; {!$Record.RecordType.DeveloperName} = &apos;Outgoing_Exchange&apos;</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
