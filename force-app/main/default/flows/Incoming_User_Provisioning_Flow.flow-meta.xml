    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>ISB-6085 / ISB-6136 — Auto-provisions a Salesforce Experience Cloud user when PGID is assigned to an Incoming Exchange Program Enrollment. Sends welcome email T-01 on provisioning. Depends on ProgramEnrollmentTrigger setting PGID__c. Uses InternationalExchangeUserCreation Apex.</description>
    <environments>Default</environments>
    <label>Incoming User Provisioning Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
