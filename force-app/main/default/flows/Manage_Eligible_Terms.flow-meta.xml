    <decisions>
        <name>dec_CheckAcademicTerm</name>
        <label>Academic Term Found?</label>
        <locationX>776</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No Academic Term</defaultConnectorLabel>
        <rules>
            <name>rule_TermExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>rec_FeesMaster.Academic_Term__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>scr_ErrorNoTerm</targetReference>
            </connector>
            <label>Term is Null</label>
        </rules>
        <rules>
            <name>rule_TermExists_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>rec_FeesMaster.Academic_Term__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_AcademicTerm</targetReference>
            </connector>
            <label>Term Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>dec_CheckIfSelected</name>
        <label>Was This Session Selected?</label>
        <locationX>1150</locationX>
        <locationY>2114</locationY>
        <defaultConnector>
            <targetReference>lp_CreateEligibleTerms</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Selected</defaultConnectorLabel>
        <rules>
            <name>rule_SessionSelected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>txt_SelectedSessionIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>lp_CreateEligibleTerms.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>act_CreateEligibleTerm</targetReference>
            </connector>
            <label>Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>dec_DuplicateCheck</name>
        <label>Is Session Name Already Added?</label>
        <locationX>952</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>asn_AddUniqueSession</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a Duplicate</defaultConnectorLabel>
        <rules>
            <name>rule_IsDuplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>txt_UniqueNames</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>lp_DeduplicateSessions.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>lp_DeduplicateSessions</targetReference>
            </connector>
            <label>Is Duplicate - Skip</label>
        </rules>
    </decisions>
    <decisions>
        <name>dec_ExistingRecordsFound</name>
        <label>Existing Records Found?</label>
        <locationX>930</locationX>
        <locationY>1706</locationY>
        <defaultConnector>
            <targetReference>lp_CreateEligibleTerms</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Existing Records</defaultConnectorLabel>
        <rules>
            <name>rule_ExistingFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_ExistingTerms</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>scr_ConfirmDelete</targetReference>
            </connector>
            <label>Existing Records Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>dec_SessionsFound</name>
        <label>Academic Sessions Found?</label>
        <locationX>776</locationX>
        <locationY>1274</locationY>
        <defaultConnectorLabel>No Sessions</defaultConnectorLabel>
        <rules>
            <name>rule_SessionsExist</name>
