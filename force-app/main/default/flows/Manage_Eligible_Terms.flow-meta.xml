            </conditions>
            <connector>
                <targetReference>scr_ErrorNoSessions</targetReference>
            </connector>
            <label>No Sessions Found</label>
        </rules>
        <rules>
            <name>rule_SessionsExist_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_AcademicSessions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>scr_SelectAcademicSessions</targetReference>
            </connector>
            <label>Sessions Found</label>
        </rules>
    </decisions>
    <description>Screen Flow to manage academic session eligibility for ISB Fees Master</description>
