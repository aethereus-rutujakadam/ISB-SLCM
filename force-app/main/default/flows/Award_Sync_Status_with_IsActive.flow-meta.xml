            </connector>
            <label>Active Selected</label>
        </rules>
        <rules>
            <name>Inactive_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Inactive</targetReference>
            </connector>
            <label>Inactive Selected</label>
        </rules>
