        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Exam_schedule_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CustomErrorMessage</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Exam Schedule Record Already Present For This Course Combination : &apos; +  {!Get_Exam_schedule_Record.Name}</expression>
    </formulas>
    <interviewLabel>Exam Schedule Before Insert Update flow {!$Flow.CurrentDateTime}</interviewLabel>
