    <formulas>
        <name>fTimestamp</name>
        <dataType>String</dataType>
        <expression>TEXT(DAY(DATEVALUE({!$Flow.CurrentDateTime} + (5.5/24)))) &amp; &quot;-&quot; &amp; 
TEXT(MONTH(DATEVALUE({!$Flow.CurrentDateTime} + (5.5/24)))) &amp; &quot;-&quot; &amp; 
TEXT(YEAR(DATEVALUE({!$Flow.CurrentDateTime} + (5.5/24)))) &amp; &quot; &quot; &amp; 
IF(
    OR(
        VALUE(MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 12, 2)) = 0, 
        VALUE(MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 12, 2)) = 12
    ),
    &quot;12&quot;,
    TEXT(VALUE(MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 12, 2)) - 
    IF(VALUE(MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 12, 2)) &gt; 12, 12, 0))
) &amp; &quot;:&quot; &amp; 
MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 15, 2) &amp; &quot; &quot; &amp; 
IF(VALUE(MID(TEXT({!$Flow.CurrentDateTime} + (5.5/24)), 12, 2)) &gt;= 12, &quot;PM&quot;, &quot;AM&quot;)</expression>
    </formulas>
    <formulas>
        <name>fUpdatedNote</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!Get_Records_1.Notes__c}),
    &quot;[&quot; &amp; {!fTimestamp} &amp; &quot;] &quot; &amp; {!Enter_your_notes_here},
    {!Get_Records_1.Notes__c} &amp; BR() &amp; 
    &quot;[&quot; &amp; {!fTimestamp} &amp; &quot;] &quot; &amp; {!Enter_your_notes_here}
)</expression>
    </formulas>
