<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_GPA</name>
        <label>Assign GPA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TotalGPA</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CalculateCurrentGPA</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NumberOfRecords</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CalculateRecordCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_ES</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>CalculateCurrentGPA</name>
        <dataType>Number</dataType>
        <expression>{!TotalGPA} + NULLVALUE({!Loop_on_ES.GPA__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedCGPA</name>
        <dataType>Number</dataType>
        <expression>{!TotalGPA} / {!NumberOfRecords}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculateRecordCount</name>
        <dataType>Number</dataType>
        <expression>{!NumberOfRecords} + 1</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Enrollment Session After Insert Update Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Enrollment Session After Insert Update Flow</label>
    <loops>
        <name>Loop_on_ES</name>
        <label>Loop on ES</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Enrollment_Sessions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_GPA</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_CGPA_on_PE</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Enrollment_Sessions</name>
        <label>Get Enrollment Sessions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_on_ES</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Program_Enrollment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Program_Enrollment__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Enrollment_Session__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_CGPA_on_PE</name>
        <label>Update CGPA on PE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Program_Enrollment__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CGPA__c</field>
            <value>
                <elementReference>CalculatedCGPA</elementReference>
            </value>
        </inputAssignments>
        <object>ProgramEnrollment</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Enrollment_Sessions</targetReference>
        </connector>
        <object>Enrollment_Session__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>NumberOfRecords</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>TotalGPA</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
