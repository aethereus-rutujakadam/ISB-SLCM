<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Input: HTML body from flow -->
            <property
                name="htmlBody"
                type="String"
                label="HTML Body (Input)"
                description="The rendered HTML body from the email template"
                role="inputOnly"
            />
            <!-- Output: edited HTML body back to flow -->
            <property
                name="editedHtmlBody"
                type="String"
                label="Edited HTML Body (Output)"
                description="The edited HTML body to be sent"
                role="outputOnly"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>